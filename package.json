    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:visual": "playwright test visual",
    "lighthouse": "node scripts/lighthouse.mjs",
    "audit:delivery": "node scripts/audit-delivery.mjs",
    "test:ci": "playwright test --config=playwright.ci.config.ts"
  },
  "dependencies": {
    "@fontsource/roboto-mono": "5.3.0",
    "@mswjs/socket.io-binding": "0.2.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "axios": "1.21.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.63.0",
    "msw": "2.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io-client": "4.8.4",
